{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlexusTerm",
  "version": "0.1.0",
  "identifier": "dev.plexusterm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlexusTerm",
        "width": 1200,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Terminal and remote-session manager for Linux",
    "longDescription": "PlexusTerm is a terminal and remote-session manager: local shells, SSH with jump hosts, an SFTP browser, SSH tunnels, serial consoles, split panes with multi-execution and saved sessions (with another app import).",
    "publisher": "Jorge Alonso",
    "copyright": "\u00a9 2026 Jorge Alonso",
    "linux": {
      "deb": {
        "section": "net"
      }
    }
  }
}
